<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ConcurrentJobEngine.Core\ConcurrentJobEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ConcurrentJobEngine</PackageId>
    <Version>1.0.1</Version>
    <Authors>Ali Gohar</Authors>
    <Company>Ali Gohar</Company>
    <Description>A high-performance in-process concurrent job processing engine for C# .NET supporting priority scheduling, exponential backoff retries with jitter, dead-letter store, metrics, and graceful shutdown.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>job-processor queue priority-queue worker-pool concurrency async retry-policy dotnet csharp</PackageTags>
    <RepositoryUrl>https://github.com/AliGohar2151/ConcurrentJobEngine.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ConcurrentJobEngine.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
